          "value": "Low"
        },
        {
          "type": "equals",
          "path": "byId[\"SF-01\"].likelihood",
          "value": "Possible"
        },
        {
          "type": "contains",
          "path": "byId[\"SF-01\"].quote",
          "value": "rotated annually"
        },
        { "type": "equals", "path": "byId[\"SF-02\"].isGap", "value": true },
        {
          "type": "equals",
          "path": "byId[\"SF-02\"].severity",
          "value": "Medium"
        },
        { "type": "equals", "path": "byId[\"SF-02\"].verified", "value": true },
        {
          "type": "contains",
          "path": "byId[\"SF-02\"].quote",
          "value": "not been provided"
        }
      ]
