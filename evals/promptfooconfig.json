    {
      "description": "Sterling complete pack uses the recorded fixture and scores 23 / Low",
      "vars": { "task": "triage", "vendor": "sterling-fintech" },
      "assert": [
        { "type": "equals", "path": "modeKind", "value": "demo" },
        { "type": "equals", "path": "score", "value": 23 },
        { "type": "equals", "path": "rating", "value": "Low" },
        { "type": "equals", "path": "baselineScore", "value": 23 },
        { "type": "equals", "path": "findingCount", "value": 2 },
        { "type": "equals", "path": "documentCount", "value": 4 },
        { "type": "equals", "path": "wordCount", "value": 1497 },
        { "type": "equals", "path": "manualMinutes", "value": 374 },
        { "type": "equals", "path": "triageSeconds", "value": 44 },
        { "type": "equals", "path": "hours", "value": 6.2 },
        { "type": "equals", "path": "assessedDomains", "value": 2 },
        { "type": "equals", "path": "allEvidenceVerified", "value": true },
        { "type": "equals", "path": "allDocumentsSynthetic", "value": true },
        {
