{
  "description": "Vendor risk triage evals (demo mode, no model calls)",
  "providers": ["file://evals/provider.ts"],
  "prompts": ["{{task}}"],
  "tests": [
    {
      "description": "Northwind complete pack uses the recorded fixture and scores 68 / High",
      "vars": { "task": "triage", "vendor": "northwind-logistics" },
      "assert": [
        { "type": "equals", "path": "blockedLive", "value": false },
        { "type": "equals", "path": "modeKind", "value": "demo" },
        { "type": "equals", "path": "provider", "value": "mock" },
        { "type": "equals", "path": "model", "value": "deterministic" },
        { "type": "equals", "path": "score", "value": 68 },
        { "type": "equals", "path": "rating", "value": "High" },
        { "type": "equals", "path": "baselineScore", "value": 68 },
        { "type": "equals", "path": "findingCount", "value": 6 },
        { "type": "equals", "path": "followUpCount", "value": 6 },
        { "type": "equals", "path": "documentCount", "value": 4 },
        { "type": "equals", "path": "wordCount", "value": 1537 },
        { "type": "equals", "path": "manualMinutes", "value": 384 },
        { "type": "equals", "path": "triageSeconds", "value": 45 },
        { "type": "equals", "path": "hours", "value": 6.4 },
        { "type": "equals", "path": "assessedDomains", "value": 5 },
        { "type": "equals", "path": "allEvidenceVerified", "value": true },
        { "type": "equals", "path": "allDocumentsSynthetic", "value": true },
        {
          "type": "includes",
          "path": "unassessedDomains",
          "value": "Data Protection"
        },
        {
          "type": "includes",
          "path": "unassessedDomains",
          "value": "Contractual"
        },
        {
          "type": "equals",
          "path": "byId[\"NW-01\"].severity",
          "value": "High"
        },
        {
          "type": "equals",
          "path": "byId[\"NW-01\"].likelihood",
          "value": "Almost certain"
        },
        { "type": "equals", "path": "byId[\"NW-01\"].isGap", "value": false },
        { "type": "equals", "path": "byId[\"NW-01\"].verified", "value": true },
        { "type": "equals", "path": "byId[\"NW-01\"].match", "value": "exact" },
        {
          "type": "equals",
          "path": "byId[\"NW-01\"].finding",
          "value": "MFA not enforced for privileged accounts"
        },
        {
          "type": "contains",
          "path": "byId[\"NW-01\"].quote",
          "value": "MFA is optional"
        },
        {
          "type": "contains",
          "path": "byId[\"NW-01\"].followUp",
          "value": "mandatory for every administrator"
        },
        { "type": "equals", "path": "byId[\"NW-05\"].isGap", "value": true },
        { "type": "equals", "path": "byId[\"NW-05\"].verified", "value": true },
        { "type": "equals", "path": "byId[\"NW-06\"].isGap", "value": true },
        {
          "type": "contains",
          "path": "byId[\"NW-06\"].quote",
          "value": "No completed recovery exercise report"
        }
      ]
    },
    {
      "description": "Apex complete pack uses the recorded fixture and scores 71 / High",
      "vars": { "task": "triage", "vendor": "apex-biolabs" },
      "assert": [
        { "type": "equals", "path": "modeKind", "value": "demo" },
        { "type": "equals", "path": "score", "value": 71 },
        { "type": "equals", "path": "rating", "value": "High" },
        { "type": "equals", "path": "baselineScore", "value": 71 },
        { "type": "equals", "path": "findingCount", "value": 5 },
        { "type": "equals", "path": "documentCount", "value": 3 },
        { "type": "equals", "path": "wordCount", "value": 1421 },
        { "type": "equals", "path": "manualMinutes", "value": 355 },
        { "type": "equals", "path": "triageSeconds", "value": 42 },
        { "type": "equals", "path": "hours", "value": 5.9 },
        { "type": "equals", "path": "assessedDomains", "value": 4 },
        { "type": "equals", "path": "allEvidenceVerified", "value": true },
        { "type": "equals", "path": "allDocumentsSynthetic", "value": true },
        { "type": "gte", "path": "pages", "value": 2 },
        { "type": "equals", "path": "firstLocation", "value": "Page 1" },
        {
          "type": "includes",
          "path": "unassessedDomains",
          "value": "Access Control"
        },
        {
          "type": "includes",
          "path": "unassessedDomains",
          "value": "Incident Response"
        },
        {
          "type": "includes",
          "path": "unassessedDomains",
          "value": "Vendor Sub-processors"
