    {
      "description": "An exact source quotation verifies",
      "vars": {
        "task": "citation",
        "source": "MFA is optional for all administrative accounts.",
        "quote": "MFA is optional for all administrative accounts."
      },
      "assert": [
        { "type": "equals", "path": "verified", "value": true },
        { "type": "equals", "path": "match", "value": "exact" },
        {
          "type": "equals",
          "path": "matchedLocation",
          "value": "Document start"
        },
        {
          "type": "equals",
          "path": "matchedQuote",
          "value": "MFA is optional for all administrative accounts."
        }
      ]
    },
    {
      "description": "Case and whitespace differences verify as a normalized match",
      "vars": {
        "task": "citation",
        "source": "MFA is\n optional for all administrative accounts.",
        "quote": "mfa is optional for all administrative accounts."
      },
      "assert": [
        { "type": "equals", "path": "verified", "value": true },
        { "type": "equals", "path": "match", "value": "normalized" }
      ]
    },
    {
      "description": "A single-character typo in a long quotation verifies as a fuzzy match",
      "vars": {
        "task": "citation",
        "source": "MFA is optional for all administrative accounts.",
        "quote": "MFA is optional for all administrativ accounts."
      },
      "assert": [
        { "type": "equals", "path": "verified", "value": true },
        { "type": "equals", "path": "match", "value": "fuzzy" },
        {
          "type": "equals",
          "path": "matchedQuote",
          "value": "MFA is optional for all administrative accounts."
        }
      ]
    },
    {
      "description": "A changed hour value does not verify",
      "vars": {
        "task": "citation",
        "source": "Customers are notified within 72 hours of confirmation.",
        "quote": "Customers are notified within 24 hours of confirmation."
      },
      "assert": [
        { "type": "equals", "path": "verified", "value": false },
        { "type": "equals", "path": "match", "value": "unverified" },
        { "type": "equals", "path": "matchedQuote", "value": null }
      ]
    },
    {
      "description": "Dropping a negation does not verify",
      "vars": {
        "task": "citation",
        "source": "MFA is not enforced for administrative accounts.",
        "quote": "MFA is enforced for administrative accounts."
      },
      "assert": [
        { "type": "equals", "path": "verified", "value": false },
        { "type": "equals", "path": "match", "value": "unverified" }
      ]
    },
    {
      "description": "A quotation with an unknown document id does not verify",
      "vars": {
        "task": "citation",
        "source": "MFA is optional for all administrative accounts.",
        "quote": "MFA is optional for all administrative accounts.",
        "docId": "missing-doc",
        "knownDoc": false
      },
      "assert": [
        { "type": "equals", "path": "verified", "value": false },
        { "type": "equals", "path": "match", "value": "unverified" },
        { "type": "equals", "path": "matchedLocation", "value": null }
      ]
    },
    {
      "description": "A verified quotation keeps the source anchor when the claimed location is wrong",
      "vars": {
        "task": "citation",
        "source": "# Access\nMFA is optional for all administrative accounts.\n# Other\nUnrelated text stays here for the anchor.",
        "quote": "MFA is optional for all administrative accounts.",
        "claimedLocation": "Wrong"
      },
      "assert": [
        { "type": "equals", "path": "verified", "value": true },
        { "type": "equals", "path": "match", "value": "exact" },
        { "type": "equals", "path": "matchedLocation", "value": "Access" }
      ]
    },
    {
      "description": "Rating bands follow the scoring framework boundaries",
      "vars": { "task": "bands" },
      "assert": [
        { "type": "equals", "path": "band0", "value": "Low" },
        { "type": "equals", "path": "band24", "value": "Low" },
        { "type": "equals", "path": "band25", "value": "Medium" },
        { "type": "equals", "path": "band49", "value": "Medium" },
        { "type": "equals", "path": "band50", "value": "High" },
        { "type": "equals", "path": "band79", "value": "High" },
        { "type": "equals", "path": "band80", "value": "Critical" },
        { "type": "equals", "path": "band100", "value": "Critical" }
      ]
    },
    {
      "description": "Finding risk is severity times likelihood, and mitigated risk is zero",
      "vars": { "task": "formula" },
      "assert": [
        { "type": "equals", "path": "highLikely", "value": 56.25 },
        { "type": "equals", "path": "criticalCertain", "value": 100 },
        { "type": "equals", "path": "lowUnlikely", "value": 6.25 },
        { "type": "equals", "path": "mitigated", "value": 0 },
        { "type": "equals", "path": "accepted", "value": 56.25 }
      ]
    },
    {
      "description": "With no provider key the review mode is demo",
      "vars": { "task": "mode", "env": {} },
      "assert": [
        { "type": "equals", "path": "modeKind", "value": "demo" },
        { "type": "equals", "path": "provider", "value": "mock" },
        { "type": "equals", "path": "model", "value": "deterministic" },
        {
          "type": "equals",
          "path": "label",
          "value": "Demo mode: mock AI responses"
        },
        { "type": "equals", "path": "error", "value": null }
      ]
    },
    {
      "description": "Selecting a provider without that provider's key stays in demo mode",
      "vars": {
        "task": "mode",
        "env": {
          "LLM_PROVIDER": "openai",
          "ANTHROPIC_API_KEY": "test-key-never-real"
        }
      },
      "assert": [
        { "type": "equals", "path": "modeKind", "value": "demo" },
        { "type": "equals", "path": "provider", "value": "mock" },
        { "type": "equals", "path": "model", "value": "deterministic" },
        { "type": "equals", "path": "error", "value": null }
      ]
    },
    {
      "description": "An unsupported provider name is rejected",
      "vars": { "task": "mode", "env": { "LLM_PROVIDER": "unsupported" } },
      "assert": [
        { "type": "equals", "path": "modeKind", "value": null },
        { "type": "contains", "path": "error", "value": "LLM_PROVIDER" }
      ]
    },
    {
      "description": "A provider key would select live mode, and the eval does not call the provider",
      "vars": {
        "task": "triage",
        "vendor": "northwind-logistics",
        "env": { "OPENAI_API_KEY": "test-key-never-real" }
      },
      "assert": [
        { "type": "equals", "path": "blockedLive", "value": true },
        { "type": "equals", "path": "modeKind", "value": "live" },
        { "type": "equals", "path": "provider", "value": "openai" },
        { "type": "equals", "path": "model", "value": "gpt-4.1-mini" },
        { "type": "equals", "path": "documentCount", "value": 4 },
        { "type": "equals", "path": "score", "value": null },
        { "type": "equals", "path": "executiveSummary", "value": null },
        { "type": "equals", "path": "calledModel", "value": false },
        { "type": "equals", "path": "networkRequests", "value": 0 }
      ]
    },
    {
      "description": "Empty, unsupported, oversized and unreadable files are rejected",
      "vars": { "task": "intake-errors" },
      "assert": [
        { "type": "contains", "path": "empty", "value": "no readable text" },
        { "type": "contains", "path": "unsupported", "value": "Choose a PDF" },
        { "type": "contains", "path": "oversized", "value": "too large" },
        { "type": "contains", "path": "corrupt", "value": "couldn't read" }
      ]
    },
    {
      "description": "Markdown intake keeps the heading anchor",
      "vars": {
        "task": "intake-markdown",
        "name": "policy.md",
        "text": "# Access\nMFA is optional."
      },
      "assert": [
        { "type": "equals", "path": "location", "value": "Access" },
        { "type": "equals", "path": "wordCount", "value": 5 },
        { "type": "contains", "path": "text", "value": "optional" }
      ]
    },
    {
      "description": "The Apex questionnaire PDF yields page text and anchors",
      "vars": {
        "task": "intake-pdf",
        "vendor": "apex-biolabs",
        "docId": "apex-biolabs-doc-1"
      },
      "assert": [
        { "type": "gte", "path": "pages", "value": 2 },
        { "type": "equals", "path": "firstLocation", "value": "Page 1" },
        { "type": "contains", "path": "text", "value": "SYNTHETIC DEMO DATA" },
        { "type": "contains", "path": "text", "value": "18 months ago" }
      ]
    },
    {
      "description": "Markdown export includes the adjusted score, note, citation and demo label",
      "vars": {
        "task": "export",
        "vendor": "northwind-logistics",
        "findingId": "NW-01",
        "note": "Compensating control recorded.",
        "severity": "Medium"
      },
      "assert": [
        { "type": "equals", "path": "score", "value": 64 },
        { "type": "equals", "path": "rating", "value": "High" },
        { "type": "equals", "path": "baselineScore", "value": 68 },
        { "type": "contains", "path": "markdown", "value": "64/100" },
        { "type": "contains", "path": "markdown", "value": "baseline 68" },
        {
          "type": "contains",
          "path": "markdown",
          "value": "Compensating control recorded."
        },
        { "type": "contains", "path": "markdown", "value": "MFA is optional" },
        {
          "type": "contains",
          "path": "markdown",
          "value": "SYNTHETIC DEMO DATA"
        },
        {
          "type": "contains",
          "path": "markdown",
          "value": "## Follow-up questions"
        },
        { "type": "equals", "path": "emailGreeting", "value": true },
        { "type": "equals", "path": "emailNamesVendor", "value": true },
        { "type": "contains", "path": "email", "value": "Synthetic demo data" }
      ]
    },
    {
      "description": "Duplicate finding ids are renamed and a missing quotation stays unverified",
      "vars": { "task": "assemble" },
      "assert": [
        { "type": "equals", "path": "findingCount", "value": 3 },
        { "type": "equals", "path": "firstId", "value": "X" },
        { "type": "equals", "path": "secondId", "value": "X-2" },
        { "type": "equals", "path": "thirdId", "value": "Q" },
        { "type": "equals", "path": "firstGap", "value": true },
        { "type": "equals", "path": "secondGap", "value": true },
        { "type": "equals", "path": "thirdIsGap", "value": false },
        { "type": "equals", "path": "thirdVerified", "value": false },
        { "type": "equals", "path": "thirdMatch", "value": "unverified" },
        {
          "type": "equals",
          "path": "thirdQuote",
          "value": "Breach notice is sent within 24 hours always."
        },
        { "type": "equals", "path": "followUpCount", "value": 3 }
      ]
    },
    {
      "description": "Analyst overrides restore for the same documents and ignore corrupt saved state",
      "vars": { "task": "persist", "vendor": "northwind-logistics" },
      "assert": [
        { "type": "equals", "path": "restoredSeverity", "value": "Low" },
        {
          "type": "equals",
          "path": "restoredNote",
          "value": "Compensating control recorded."
        },
        {
          "type": "equals",
          "path": "restoredQuestion",
          "value": "Please send the current MFA evidence."
        },
        { "type": "equals", "path": "corruptSeverity", "value": "High" },
        { "type": "equals", "path": "emptySeverity", "value": "High" },
        { "type": "equals", "path": "keyChanged", "value": true },
        { "type": "equals", "path": "keyPrefix", "value": true }
      ]
    },
    {
      "description": "Extraction instructions treat documents as untrusted evidence and do not ask for a score",
      "vars": { "task": "prompt" },
      "assert": [
        {
          "type": "contains",
          "path": "systemPrompt",
          "value": "UNTRUSTED EVIDENCE"
        },
        {
          "type": "contains",
          "path": "systemPrompt",
          "value": "NEVER invent or paraphrase a quote"
        },
        {
          "type": "contains",
          "path": "systemPrompt",
          "value": "Do not calculate a score"
        },
        {
          "type": "contains",
          "path": "systemPrompt",
          "value": "24-hour initial notification"
        },
        {
          "type": "contains",
          "path": "systemPrompt",
          "value": "Access Control"
        },
        {
          "type": "contains",
          "path": "systemPrompt",
          "value": "no findings means a vendor is safe"
        },
        { "type": "equals", "path": "calledModel", "value": false }
      ]
    }
  ]
}
