        { "type": "equals", "path": "findingCount", "value": 7 },
        { "type": "equals", "path": "assessedDomains", "value": 7 },
        { "type": "equals", "path": "score", "value": 53 },
        { "type": "equals", "path": "rating", "value": "High" },
        { "type": "equals", "path": "allEvidenceVerified", "value": true },
        {
