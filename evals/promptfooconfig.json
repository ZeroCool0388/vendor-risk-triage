    {
      "description": "Downgrading Northwind NW-01 from High to Medium scores 64 / High",
      "vars": {
        "task": "override-score",
        "vendor": "northwind-logistics",
        "findingId": "NW-01",
        "severity": "Medium"
      },
      "assert": [
        { "type": "equals", "path": "score", "value": 64 },
        { "type": "equals", "path": "rating", "value": "High" },
        { "type": "equals", "path": "severity", "value": "Medium" },
        { "type": "equals", "path": "findingScore", "value": 50 },
        { "type": "equals", "path": "status", "value": "Needs follow-up" }
      ]
    },
    {
      "description": "Accepting Northwind NW-01 keeps its finding score and the 68 overall score",
      "vars": {
        "task": "override-score",
        "vendor": "northwind-logistics",
        "findingId": "NW-01",
        "status": "Accepted"
      },
      "assert": [
        { "type": "equals", "path": "score", "value": 68 },
        { "type": "equals", "path": "rating", "value": "High" },
        { "type": "equals", "path": "status", "value": "Accepted" },
        { "type": "equals", "path": "severity", "value": "High" },
        { "type": "equals", "path": "findingScore", "value": 75 }
      ]
    },
    {
      "description": "Mitigating Northwind NW-01 zeroes that finding and lowers the overall score",
      "vars": {
        "task": "override-score",
        "vendor": "northwind-logistics",
        "findingId": "NW-01",
        "status": "Mitigated"
      },
      "assert": [
        { "type": "equals", "path": "score", "value": 57 },
        { "type": "equals", "path": "rating", "value": "High" },
        { "type": "equals", "path": "status", "value": "Mitigated" },
        { "type": "equals", "path": "findingScore", "value": 0 }
      ]
    },
    {
      "description": "A one-document Northwind pack is keyword-screened instead of the recorded fixture",
      "vars": {
        "task": "triage",
        "vendor": "northwind-logistics",
        "docIds": ["northwind-logistics-doc-1"]
      },
      "assert": [
        { "type": "equals", "path": "modeKind", "value": "rule-based" },
        { "type": "equals", "path": "provider", "value": "rules" },
        { "type": "equals", "path": "model", "value": "keyword-v1" },
        {
          "type": "equals",
          "path": "label",
          "value": "Rule-based (demo mode)"
        },
        { "type": "equals", "path": "documentCount", "value": 1 },
        { "type": "equals", "path": "findingCount", "value": 7 },
        { "type": "equals", "path": "score", "value": 50 },
        { "type": "equals", "path": "rating", "value": "High" },
        { "type": "equals", "path": "allEvidenceVerified", "value": true },
        { "type": "equals", "path": "allDocumentsSynthetic", "value": true },
        {
          "type": "contains",
          "path": "executiveSummary",
          "value": "Rule-based screening reviewed 1 document"
        },
        {
          "type": "contains",
          "path": "executiveSummary",
          "value": "6 domains contain passages needing follow-up"
        },
        {
          "type": "not-contains",
          "path": "executiveSummary",
          "value": "Northwind's evidence identifies"
        },
        {
          "type": "contains",
          "path": "byDomain[\"Access Control\"].quote",
          "value": "MFA is optional for legacy administrator accounts."
        },
        {
          "type": "equals",
          "path": "byDomain[\"Access Control\"].severity",
          "value": "High"
        },
        {
          "type": "contains",
          "path": "byDomain[\"Data Protection\"].quote",
          "value": "No customer data transfers outside the UK or EU occur."
        },
        {
          "type": "contains",
          "path": "byDomain[\"Business Continuity\"].quote",
          "value": "An annual recovery exercise is planned."
        },
        {
          "type": "contains",
          "path": "byDomain[\"Incident Response\"].quote",
          "value": "within 72 hours"
        },
        {
          "type": "contains",
          "path": "byDomain[\"Vendor Sub-processors\"].quote",
          "value": "not yet included"
        },
        {
          "type": "equals",
          "path": "byDomain[\"Compliance & Certifications\"].isGap",
          "value": true
        },
        {
          "type": "equals",
          "path": "byDomain[\"Compliance & Certifications\"].verified",
          "value": true
        },
        {
          "type": "contains",
          "path": "byDomain[\"Compliance & Certifications\"].quote",
          "value": "No dated penetration test report"
        },
        {
          "type": "equals",
          "path": "byDomain[\"Contractual\"].isGap",
          "value": true
        },
        {
          "type": "equals",
          "path": "byDomain[\"Contractual\"].evidenceCount",
          "value": 0
        },
        {
          "type": "equals",
          "path": "byDomain[\"Contractual\"].severity",
          "value": "Low"
        },
        {
          "type": "equals",
          "path": "byDomain[\"Contractual\"].likelihood",
          "value": "Unlikely"
        }
      ]
    },
    {
      "description": "Adding an upload to a complete Northwind pack does not reuse the recorded fixture",
      "vars": {
        "task": "triage",
        "vendor": "northwind-logistics",
        "uploads": [
          {
            "name": "note.md",
            "text": "SYNTHETIC DEMO DATA. Fictional company. Not real.\n\nAdditional note for a fictional review."
          }
        ]
      },
      "assert": [
        { "type": "equals", "path": "modeKind", "value": "rule-based" },
        { "type": "equals", "path": "documentCount", "value": 5 },
        { "type": "equals", "path": "findingCount", "value": 7 },
        { "type": "equals", "path": "allDocumentsSynthetic", "value": true },
        {
          "type": "contains",
          "path": "executiveSummary",
          "value": "Rule-based screening reviewed 5 documents"
        },
        {
          "type": "not-contains",
          "path": "executiveSummary",
          "value": "Northwind's evidence identifies"
        }
      ]
    },
